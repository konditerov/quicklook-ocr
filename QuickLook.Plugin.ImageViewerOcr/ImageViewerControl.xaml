<UserControl x:Class="QuickLook.Plugin.ImageViewerOcr.ImageViewerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True"
             Background="Transparent"
             PreviewKeyDown="OnPreviewKeyDown"
             PreviewMouseWheel="OnMouseWheel"
             MouseDown="OnMouseDown"
             MouseMove="OnMouseMove"
             MouseUp="OnMouseUp"
             MouseLeave="OnMouseLeave">
    <UserControl.ContextMenu>
        <ContextMenu Opened="Menu_Opened">
            <MenuItem x:Name="CopyItem" Header="Копировать" Click="CopySelection_Click" />
            <MenuItem Header="Копировать весь текст" Click="CopyAll_Click" />
        </ContextMenu>
    </UserControl.ContextMenu>
    <Grid x:Name="Viewport" ClipToBounds="True" SizeChanged="Viewport_SizeChanged">
        <Grid x:Name="World">
            <Grid.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="Scale" />
                    <TranslateTransform x:Name="Translate" />
                </TransformGroup>
            </Grid.RenderTransform>
            <Image x:Name="Photo" Stretch="Fill" />
            <Canvas x:Name="Words" />
        </Grid>
        <Canvas IsHitTestVisible="False">
            <Rectangle x:Name="Band"
                       Fill="#330050C8"
                       Stroke="#A050A0FF"
                       StrokeThickness="1"
                       Visibility="Collapsed" />
        </Canvas>
        <TextBlock x:Name="ErrorText"
                   Margin="16"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Foreground="White"
                   Background="#CC202020"
                   Padding="12"
                   TextWrapping="Wrap"
                   Visibility="Collapsed" />
    </Grid>
</UserControl>
