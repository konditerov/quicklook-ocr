<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net472</TargetFramework>
    <RootNamespace>QuickLook.Plugin.ImageViewerOcr</RootNamespace>
    <AssemblyName>QuickLook.Plugin.ImageViewerOcr</AssemblyName>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <Version>0.1.1</Version>
    <Authors>Ilia Konditerov</Authors>
    <Copyright>Copyright © 2026 Ilia Konditerov</Copyright>
    <Description>Выделение и копирование текста на изображениях в QuickLook.</Description>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="QuickLook.Common\**" />
    <EmbeddedResource Remove="QuickLook.Common\**" />
    <None Remove="QuickLook.Common\**" />
    <Page Remove="QuickLook.Common\**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="QuickLook.Common\QuickLook.Common.csproj">
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.ML.OnnxRuntime.DirectML" Version="1.19.2" />
    <PackageReference Include="Microsoft.Windows.SDK.Contracts" Version="10.0.19041.1" />
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>

  <ItemGroup>
    <None Include="QuickLook.Plugin.Metadata.config" CopyToOutputDirectory="PreserveNewest" />
    <None Include="models\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>QuickLook.Plugin.ImageViewerOcr.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
